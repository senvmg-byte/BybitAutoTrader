# Copy to .env. Keep .env private and never put exchange credentials in the APK.
HOST=127.0.0.1
PORT=8787
APP_TOKEN=replace-with-at-least-32-random-characters
# Live switches are independent and OFF by default.
LIVE_SPOT_ENABLED=false
LIVE_LINEAR_ENABLED=false
LIVE_INVERSE_ENABLED=false
LIVE_OPTION_ENABLED=false
BYBIT_API_KEY=
BYBIT_API_SECRET=
PAPER_STARTING_USDT=1000
MAX_ORDER_USDT=25
SYMBOL=BTC/USDT
# Set both certificate paths to serve a remote/mobile connection over HTTPS.
HTTPS_CERT_FILE=
HTTPS_KEY_FILE=
